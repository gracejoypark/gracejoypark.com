---
import Base from "../layouts/Base.astro";

const experience = [
  {
    org: "Infusion Magazine",
    location: "Athens, Ga.",
    role: "Member and Section Editor",
    dates: "Oct. 2025 – Present",
    bullets: [
      "Lead Editor for the Fashion and Beauty vertical, overseeing Vol. 23, Issue 1 content strategy and writer assignments.",
      "Directed the editorial process for the Fashion and Beauty vertical, editing two major drafts per issue to ensure 100 percent adherence to AP Style and brand voice.",
      "Collaborated with the editorial board to launch Vol. 23, Issue 1, curating Fashion and Beauty content that aligned with the issue's broader themes of social awareness and digital culture.",
    ],
  },
  {
    org: "The Red and Black Publishing",
    location: "Athens, Ga.",
    role: "Content Writer (training)",
    dates: "Oct. 2025 – Present",
    bullets: [
      "Developed and pitched two original story concepts to editorial leadership, demonstrating news judgment and an understanding of the publication's target audience.",
      "Transformed a raw press release into a concise, publication-ready news brief with strict adherence to AP Style and objective reporting standards.",
      "Participating in a comprehensive journalism training curriculum focused on media ethics, fact-checking and digital production workflows.",
    ],
  },
];

const otherWork = [
  {
    org: "University of Georgia Main Library",
    location: "Athens, Ga.",
    role: "Library Shelving Assistant",
    dates: "Oct. 2025 – Present",
    bullets: [
      "Shelved and organized more than 1,000 books and folios using the Library of Congress Classification system.",
      "Maintained orderliness of stack areas through regular shelf-reading and shifting collections to optimize shelf space.",
    ],
  },
  {
    org: "Bruster's Real Ice Cream",
    location: "Cumming, Ga.",
    role: "Dessert Bar Attendant and Ice Cream Scooper",
    dates: "May 2025 – July 2025",
    bullets: [
      "Provided friendly, efficient customer service in a fast-paced environment.",
      "Maintained organized workstations and adhered to food safety standards.",
    ],
  },
  {
    org: "Cumming Aquatic Center",
    location: "Cumming, Ga.",
    role: "Lifeguard and Swimming Instructor",
    dates: "Oct. 2022 – July 2023",
    bullets: [
      "Taught swim lessons to children and teens, improving technique, safety and water confidence.",
      "Managed multiple classes alongside lifeguard responsibilities. CPR and First Aid certified.",
    ],
  },
];
---

<Base title="Resume | Grace Joy Park">
  <h1>Resume</h1>
  <p class="download">
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Download as PDF &rarr;</a>
  </p>

  <hr />

  <section>
    <h2>Education</h2>
    <div class="entry">
      <div class="entry-head">
        <div>
          <strong>The University of Georgia</strong><br />
          <em>Bachelor of Journalism and Mass Communication</em>
        </div>
        <div class="meta">
          Athens, Ga.<br />
          <span class="muted">Expected May 2028</span>
        </div>
      </div>
      <ul>
        <li>Major: Journalism and Mass Communication; Certificate in News Literacy and New Media</li>
        <li>GPA: 3.76 / 4.00, Georgia HOPE Scholarship</li>
        <li>Relevant coursework: Media News and Consumers, Reporting I, Law of Mass Communication</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Journalism and Communication Experience</h2>
    {experience.map((e) => (
      <div class="entry">
        <div class="entry-head">
          <div>
            <strong>{e.org}</strong><br />
            <em>{e.role}</em>
          </div>
          <div class="meta">
            {e.location}<br />
            <span class="muted">{e.dates}</span>
          </div>
        </div>
        <ul>
          {e.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Additional Work Experience</h2>
    {otherWork.map((e) => (
      <div class="entry">
        <div class="entry-head">
          <div>
            <strong>{e.org}</strong><br />
            <em>{e.role}</em>
          </div>
          <div class="meta">
            {e.location}<br />
            <span class="muted">{e.dates}</span>
          </div>
        </div>
        <ul>
          {e.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Interests</h2>
    <p>Reading, painting, movies and swimming.</p>
  </section>
</Base>

<style>
  .download { margin-bottom: 1rem; }

  section { margin-bottom: 2.5rem; }

  .entry { margin-bottom: 1.75rem; }
  .entry:last-child { margin-bottom: 0; }

  .entry-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .meta {
    text-align: right;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  ul {
    padding-left: 1.25rem;
    margin: 0.4rem 0 0;
  }

  ul li {
    margin-bottom: 0.3rem;
    max-width: 70ch;
  }

  @media (max-width: 640px) {
    .entry-head { flex-direction: column; gap: 0.25rem; }
    .meta { text-align: left; }
  }
</style>
