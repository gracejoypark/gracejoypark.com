---
import Base from "../layouts/Base.astro";

const experience = [
  {
    org: "The Global Career Accelerator",
    location: "Remote",
    role: "Digital Marketing Intern",
    dates: "May 2026 – Present",
    bullets: [
      "Built a Shopify storefront for a mock direct-to-consumer brand, setting up the theme, navigation, brand voice and product copy from brand guidelines.",
      "Ran a competitor content analysis, defined three Instagram content pillars and wrote platform-specific community management responses.",
      "Ran A/B tests and SEO keyword research to optimize product pages and metadata.",
      "Collaborated in weekly agency-style team labs, developing customer-acquisition and brand strategy for real-world case-study brands.",
    ],
  },
  {
    org: "Devon Review",
    location: "Remote",
    role: "Copywriting Intern",
    dates: "June 2026 – Present",
    bullets: [
      "Copywriting intern on the editorial team.",
    ],
  },
  {
    org: "Infusion Magazine",
    location: "Athens, Ga.",
    role: "News Director, Executive Board",
    dates: "Incoming, Aug. 2026",
    bullets: [
      "Selected to the executive board to lead news coverage strategy and direct staff writers across the publication.",
    ],
  },
  {
    org: "Infusion Magazine",
    location: "Athens, Ga.",
    role: "Section Editor, Fashion and Beauty",
    dates: "Oct. 2025 – Aug. 2026",
    bullets: [
      "Led the Fashion and Beauty vertical for Vol. 23, Issue 1, overseeing content strategy and writer assignments.",
      "Edited two major drafts per issue to ensure adherence to AP Style and brand voice.",
    ],
  },
  {
    org: "University of Georgia Main Library",
    location: "Athens, Ga.",
    role: "Library Shelving Assistant",
    dates: "Oct. 2025 – Present",
    bullets: [
      "Shelved and organized more than 1,000 books and folios using the Library of Congress Classification system.",
      "Maintained stack-area orderliness through regular shelf-reading and shifting collections to optimize shelf space.",
    ],
  },
];

const projects = [
  {
    title: "Athens-Clarke Extends Data Center Moratorium",
    org: "Reporting I, Grady College",
    dates: "March 2026",
    href: "/work/data-center-moratorium",
    bullets: [
      "Covered a Mayor and Commission meeting and surfaced a lede from a long agenda, identifying utility costs, water use and power demand as the residents' core concerns.",
    ],
  },
  {
    title: "Former Racer Returns to Athens Twilight",
    org: "Grady Newsource",
    dates: "April 2026",
    href: "https://gradynewsource.uga.edu/live-blog-take-a-ride-with-athens-twilight-cycling-race/",
    bullets: [
      "Reported a bylined event preview, interviewing a former Twilight racer scouting the downtown course with UGA Cycling the day before the pro races.",
    ],
  },
  {
    title: "Personal Portfolio Site",
    org: "Self-directed",
    dates: "Spring 2026",
    href: "https://gracejoypark.com",
    bullets: [
      "Designed, copywrote and shipped a personal portfolio site, building it in Astro with Claude as a coding partner, deploying via GitHub to Cloudflare Pages and configuring a custom domain and email routing.",
    ],
  },
];
---

<Base title="Resume | Grace Joy Park">
  <h1>Resume</h1>
  <p class="download">
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Download as PDF &rarr;</a>
  </p>

  <hr />

  <section>
    <h2>Education</h2>
    <div class="entry">
      <div class="entry-head">
        <div>
          <strong>The University of Georgia</strong><br />
          <em>Bachelor of Arts in Advertising, Minor in Design and Media</em>
        </div>
        <div class="meta">
          Athens, Ga.<br />
          <span class="muted">Expected May 2028</span>
        </div>
      </div>
      <ul>
        <li>Certificate in News Literacy and New Media</li>
        <li>GPA: 3.77 / 4.00, Georgia HOPE Scholarship</li>
        <li>Relevant coursework: Media, News and Consumers (JOUR 3030), Reporting I, Law of Mass Communication</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Experience</h2>
    {experience.map((e) => (
      <div class="entry">
        <div class="entry-head">
          <div>
            <strong>{e.org}</strong><br />
            <em>{e.role}</em>
          </div>
          <div class="meta">
            {e.location}<br />
            <span class="muted">{e.dates}</span>
          </div>
        </div>
        <ul>
          {e.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Projects</h2>
    {projects.map((p) => (
      <div class="entry">
        <div class="entry-head">
          <div>
            <strong>
              <a href={p.href} target="_blank" rel="noopener noreferrer">{p.title}</a>
            </strong><br />
            <em>{p.org}</em>
          </div>
          <div class="meta">
            <span class="muted">{p.dates}</span>
          </div>
        </div>
        <ul>
          {p.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Skills</h2>
    <ul class="skills-list">
      <li><strong>Editorial:</strong> AP Style, copyediting, content strategy</li>
      <li><strong>Digital Marketing:</strong> Shopify, Meta Ads, SEO (Semrush, Google Trends), A/B testing, email marketing, social media strategy</li>
      <li><strong>Design and Media:</strong> Canva, CapCut, Instagram Reels</li>
      <li><strong>Productivity:</strong> Google Drive (Docs, Sheets, Slides)</li>
    </ul>
  </section>

  <section>
    <h2>Interests</h2>
    <p>Reading, painting, movies and swimming.</p>
  </section>
</Base>

<style>
  .download { margin-bottom: 1rem; }

  section { margin-bottom: 2.5rem; }

  .entry { margin-bottom: 1.75rem; }
  .entry:last-child { margin-bottom: 0; }

  .entry-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .meta {
    text-align: right;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  ul {
    padding-left: 1.25rem;
    margin: 0.4rem 0 0;
  }

  ul li {
    margin-bottom: 0.3rem;
    max-width: 70ch;
  }

  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skills-list li {
    margin-bottom: 0.4rem;
  }

  @media (max-width: 640px) {
    .entry-head { flex-direction: column; gap: 0.25rem; }
    .meta { text-align: left; }
  }
</style>
