---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import cutline from "../assets/work/cutline.jpg";

const pieces = [
  {
    title: "Former racer returns to Athens Orthopedic Clinic Twilight Criterium as vendors prepares for race weekend",
    publication: "Reporting I, Grady College",
    date: "April 2026",
    href: "/work/twilight-criterium.pdf",
    summary: "A former Twilight racer returned to scout the downtown Athens course as vendors and musicians prepared for the 46th Athens Orthopedic Clinic Twilight Criterium.",
  },
  {
    title: "SCLPT Studio brings boutique wellness to Athens",
    publication: "Reporting I, Grady College",
    date: "March 2026",
    href: "/work/sclpt-studio.pdf",
    summary: "Co-founders Alexis Cason and Genna Ringler opened a boutique fitness studio combining reformer Pilates and hot mat sculpt classes — and hit maximum capacity within a year.",
  },
  {
    title: "Athens-Clarke County Commission Extends Delay on Data Center Moratorium",
    publication: "Reporting I, Grady College",
    date: "March 2026",
    href: "/work/data-center-moratorium.pdf",
    summary: "Athens-Clarke County commissioners voted to extend the temporary pause on new data centers through June 5 after residents raised concerns about utility costs, water use, and power demand.",
  },
  {
    title: "Q&A: Cayce Reese on Intersection of Community Banking, Storytelling",
    publication: "Reporting I, Grady College",
    date: "February 2026",
    href: "/work/cayce-reese-qa.pdf",
    summary: "Cayce Reese, marketing and business development coordinator for Oconee State Bank, on community storytelling, financial honesty, and how local banks stay competitive in a digital age.",
  },
  {
    title: "Photo: \u201CICE Out of Athens\u201D rally",
    publication: "Reporting I, Grady College",
    date: "January 2026",
    image: cutline,
    summary: "Created a cutline on ICE protests.",
  },
];
---

<Base title="Work — Grace Joy Park">
  <h1>Work</h1>
  <p class="muted lead">Selected journalism, photography, and writing.</p>

  <ul class="pieces">
    {pieces.map((p) => {
      const Inner = (
        <>
          <div class="meta">
            <span class="pub">{p.publication}</span>
            <span class="dot">·</span>
            <span class="date">{p.date}</span>
          </div>
          <div class="title">{p.title}</div>
          <p class="summary">{p.summary}</p>
          {p.image && (
            <Image
              src={p.image}
              alt={p.title}
              widths={[600, 900, 1200]}
              sizes="(max-width: 720px) 100vw, 900px"
              class="photo"
            />
          )}
        </>
      );
      return (
        <li>
          {p.href ? (
            <a href={p.href} class="piece">{Inner}</a>
          ) : (
            <div class="piece piece--static">{Inner}</div>
          )}
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .lead { margin-bottom: 2.5rem; }

  .pieces {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .pieces li {
    border-top: 1px solid var(--rule);
  }
  .pieces li:last-child { border-bottom: 1px solid var(--rule); }

  .piece {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: var(--ink);
  }

  .piece:hover .title { color: var(--accent); }
  .piece--static:hover .title { color: inherit; }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dot { margin: 0 0.4rem; }

  .title {
    font-size: 1.4rem;
    font-style: italic;
    margin-bottom: 0.4rem;
  }

  .summary {
    color: var(--muted);
    margin: 0;
  }

  .piece :global(.photo) {
    margin-top: 1rem;
    width: 100%;
    max-width: 900px;
    height: auto;
    border: 1px solid var(--rule);
  }
</style>
