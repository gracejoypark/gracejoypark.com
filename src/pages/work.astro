---
import Base from "../layouts/Base.astro";

const advertising = [
  {
    title: "Nöz: Building and Marketing a Shopify Store",
    publication: "The Global Career Accelerator",
    date: "June 2026",
    href: "/work/noz-shopify",
    summary: "Built and marketed a Shopify storefront end to end for Nöz, a simulated reef-safe SPF brand, covering brand strategy, copy, SEO and conversion optimization.",
    tags: ["Digital Marketing", "Shopify", "SEO", "Copywriting", "Brand Strategy"],
  },
  {
    title: "Nöz: Designing an Instagram Post",
    publication: "The Global Career Accelerator",
    date: "June 2026",
    href: "/work/noz-social-post",
    summary: "Designed an Instagram post in Canva for Nöz, a simulated SPF brand, and built the social strategy around it from competitor research to on-brand community replies.",
    tags: ["Social Media", "Content Design", "Canva", "Instagram", "Brand Voice"],
  },
  {
    title: "charity: water: Activating the Next Generation of Supporters",
    publication: "The Global Career Accelerator",
    date: "July 2026",
    href: "/work/charity-water",
    summary: "Built a $1-a-month student donation campaign for charity: water as a capstone, running the full acquisition funnel from organic content pillars to influencer strategy, paid social and a campus ambassador program.",
    tags: ["Campaign Strategy", "Paid Social", "Influencer Marketing", "Customer Acquisition", "Social Media"],
  },
];

const journalism = [
  {
    title: "Former racer returns to Athens Orthopedic Clinic Twilight Criterium as vendors prepares for race weekend",
    publication: "Reporting I, Grady College",
    date: "April 2026",
    href: "/work/twilight",
    summary: "A former Twilight racer returned to scout the downtown Athens course as vendors and musicians prepared for the 46th Athens Orthopedic Clinic Twilight Criterium.",
    tags: ["Twilight", "Cycling", "Athens", "Event Coverage"],
  },
  {
    title: "SCLPT Studio brings boutique wellness to Athens",
    publication: "Reporting I, Grady College",
    date: "March 2026",
    href: "/work/sclpt-studio",
    summary: "Co-founders Alexis Cason and Genna Ringler opened a boutique fitness studio combining reformer Pilates and hot mat sculpt classes and hit maximum capacity within a year.",
    tags: ["Pilates", "Health and Wellness", "Athens", "Fitness", "Business"],
  },
  {
    title: "Athens-Clarke County Commission Extends Delay on Data Center Moratorium",
    publication: "Reporting I, Grady College",
    date: "March 2026",
    href: "/work/data-center-moratorium",
    summary: "Athens-Clarke County commissioners voted to extend the temporary pause on new data centers through June 5 after residents raised concerns about utility costs, water use and power demand.",
    tags: ["Athens-Clarke County", "Mayor and Commissioners", "Data Centers", "Moratorium"],
  },
  {
    title: "Q&A: Cayce Reese on Intersection of Community Banking, Storytelling",
    publication: "Reporting I, Grady College",
    date: "February 2026",
    href: "/work/cayce-reese-qa",
    summary: "Cayce Reese, marketing and business development coordinator for Oconee State Bank, on community storytelling, financial honesty and how local banks stay competitive in a digital age.",
    tags: ["Business", "Oconee State Bank", "Banking", "Storytelling"],
  },
  {
    title: "Photo: “ICE Out of Athens” rally",
    publication: "Reporting I, Grady College",
    date: "January 2026",
    summary: "Created a cutline on ICE protests.",
    tags: ["ICE", "Protest", "UGA", "Athens"],
  },
  {
    title: "Fashion and Beauty Editor",
    publication: "Infusion Magazine, Vol. 23",
    date: "2025–2026",
    href: "/work/infusion",
    summary: "Led the Fashion and Beauty section for Infusion Magazine across Vol. 23 Issue I (fall 2025) and Issue II (spring 2026), assigning and editing pieces and shaping the section's voice.",
    tags: ["Editing", "Fashion and Beauty", "Student Media", "Infusion Magazine"],
  },
];

const sections = [
  {
    heading: "Advertising and Digital Marketing",
    blurb: "Brand, copy and digital marketing projects.",
    items: advertising,
  },
  {
    heading: "Journalism and Reporting",
    blurb: "Reporting, photography and editing from Grady College.",
    items: journalism,
  },
];
---

<Base title="Work | Grace Joy Park">
  <h1>Work</h1>
  <p class="muted lead">Advertising, digital marketing and journalism.</p>

  {sections.map((section) => (
    <section class="work-section">
      <h2>{section.heading}</h2>
      {section.blurb && <p class="section-blurb muted">{section.blurb}</p>}
      <ul class="pieces">
        {section.items.map((p) => {
          const linkProps = p.href
            ? { href: p.href, target: "_blank", rel: "noopener noreferrer" }
            : null;
          const Inner = (
            <>
              <div class="meta">
                <span class="pub">{p.publication}</span>
                <span class="dot">·</span>
                <span class="date">{p.date}</span>
              </div>
              <div class="title">{p.title}</div>
              <p class="summary">{p.summary}</p>
              {p.tags && (
                <ul class="tags">
                  {p.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
            </>
          );
          return (
            <li>
              {linkProps ? (
                <a {...linkProps} class="piece">{Inner}</a>
              ) : (
                <div class="piece piece--static">{Inner}</div>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>

<style>
  .lead { margin-bottom: 2.5rem; }

  .work-section { margin-bottom: 3.5rem; }
  .work-section:last-child { margin-bottom: 0; }

  .work-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .section-blurb {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }

  .pieces {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .pieces li {
    border-top: 1px solid var(--rule);
  }
  .pieces li:last-child { border-bottom: 1px solid var(--rule); }

  .piece {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: var(--ink);
  }

  .piece:hover .title { color: var(--accent); }
  .piece--static:hover .title { color: inherit; }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dot { margin: 0 0.4rem; }

  .title {
    font-size: 1.4rem;
    font-style: italic;
    margin-bottom: 0.75rem;
  }

  .summary {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    background: transparent;
  }
</style>
