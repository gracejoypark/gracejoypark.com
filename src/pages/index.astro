---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
---

<Base>
  <section class="hero">
    <div class="left">
      <div class="portrait">
        <Image src={portrait} alt="Grace Joy Park" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
      </div>
    </div>
    <div class="intro">
      <h1>Grace Joy Park</h1>
      <p class="muted">Multimedia journalist and aspiring advertising copywriter.</p>
      <p>
        I report, photograph and edit stories about the people and places
        around Athens. This site collects my clips, photos and projects from UGA.
      </p>
      <p>
        <a href="/about">More about me &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    max-width: 880px;
    margin: 1rem auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .intro h1 {
    margin-top: 0;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait { max-width: 320px; }
    .left { max-width: 320px; }
  }
</style>
