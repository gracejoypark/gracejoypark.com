---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/gallery/interview.jpg";
---

<Base>
  <section class="hero">
    <div class="left">
      <p class="skills-line">I report, photograph and edit stories about Athens.</p>
      <div class="portrait">
        <Image src={portrait} alt="Grace Joy Park interviewing for a beat Q&A story" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
      </div>
    </div>
    <div class="intro">
      <h1>Grace Joy Park</h1>
      <p class="muted">Multimedia journalist and aspiring advertising copywriter.</p>
      <p>
        This site collects clips from my time at the University of Georgia,
        projects in progress, and what's coming next.
      </p>
      <p>
        <a href="/about">More about me &rarr;</a>
      </p>
    </div>
  </section>

  <section class="socials" aria-label="Find me online">
    <a
      class="social-card"
      href="https://www.instagram.com/grace.park_reporting/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/>
      </svg>
      <div class="social-text">
        <span class="platform">Instagram</span>
        <span class="handle">@grace.park_reporting</span>
      </div>
      <span class="cta">Follow &rarr;</span>
    </a>

    <a
      class="social-card"
      href="https://www.linkedin.com/in/grace-park-683434294/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="3" ry="3" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <rect x="6.5" y="10" width="2.2" height="7.5" fill="currentColor"/>
        <circle cx="7.6" cy="7.4" r="1.3" fill="currentColor"/>
        <path d="M11.2 10h2.1v1.1c.4-.7 1.4-1.3 2.6-1.3 2 0 2.6 1.3 2.6 3.1v4.6h-2.2v-4.1c0-1-.4-1.6-1.3-1.6s-1.5.6-1.5 1.6v4.1h-2.3V10z" fill="currentColor"/>
      </svg>
      <div class="social-text">
        <span class="platform">LinkedIn</span>
        <span class="handle">Grace Park</span>
      </div>
      <span class="cta">Connect &rarr;</span>
    </a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    margin-top: 1rem;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .skills-line {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink);
    margin: 0;
    max-width: 38ch;
  }

  .portrait {
    aspect-ratio: 3 / 2;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .intro p { max-width: 38ch; }

  /* Social widgets */
  .socials {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    background: transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .social-card:hover {
    background: #f3efe6;
    border-color: var(--accent);
  }

  .social-card .icon {
    width: 28px;
    height: 28px;
    color: var(--ink);
    flex-shrink: 0;
  }

  .social-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
    min-width: 0;
  }

  .platform {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .handle {
    font-size: 0.85rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cta {
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .social-card:hover .cta {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait { max-width: 320px; }
    .left { max-width: 320px; }

    .socials {
      grid-template-columns: 1fr;
      margin-top: 2.5rem;
    }
  }
</style>
