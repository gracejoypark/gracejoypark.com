---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/gallery/interview.jpg";
---

<Base>
  <section class="hero">
    <div class="left">
      <p class="skills-line">I report, photograph and edit stories at the University of Georgia.</p>
      <figure class="portrait-figure">
        <div class="portrait">
          <Image src={portrait} alt="Grace Joy Park interviewing for a beat Q&A story" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
        </div>
        <figcaption>
          Cayce Reese, left, marketing and business development coordinator for
          Oconee State Bank, speaks with journalism students and Grace Park at
          the Reporting I Beat Meet &amp; Greet at the Studio 100 Journalism
          Building in Athens, Ga., on Thursday, Feb. 12, 2026. Reese discussed
          community banking, financial honesty for young professionals and the
          role of integrity in business. (Photo/Sam Tupper)
        </figcaption>
      </figure>
    </div>
    <div class="intro">
      <h1>Grace Joy Park</h1>
      <p class="muted">Multimedia journalist and aspiring advertising copywriter.</p>
      <p>
        I report, photograph and edit stories about the people and places
        around Athens. This site collects my clips, photos and projects from UGA.
      </p>
      <p>
        <a href="/about">More about me &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 420px);
    gap: 3rem;
    justify-content: center;
    align-items: start;
    margin-top: 1rem;
  }

  .intro h1 {
    margin-top: 0;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .skills-line {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink);
    margin: 0;
    max-width: 38ch;
  }

  .portrait-figure {
    margin: 0;
  }

  .portrait {
    aspect-ratio: 3 / 2;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .portrait-figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
    line-height: 1.5;
  }

  .intro p { max-width: 38ch; }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait { max-width: 320px; }
    .left { max-width: 320px; }
  }
</style>
