---
import Base from "../layouts/Base.astro";
---

<Base>
  <section class="hero">
    <div class="portrait">
      <div class="placeholder">
        <span>Your photo here</span>
      </div>
    </div>
    <div class="intro">
      <h1>Grace Joy Park</h1>
      <p class="muted">Journalism &amp; advertising student at the University of Georgia.</p>
      <p>
        I write, photograph, and tell stories. This is a small home for my
        work — clips from my time at UGA, projects in progress, and what's
        coming next.
      </p>
      <p>
        <a href="/about">More about me &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    margin-top: 1rem;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-style: italic;
  }

  .intro p { max-width: 38ch; }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait { max-width: 320px; }
  }
</style>
