---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
---

<Base>
  <section class="hero">
    <div class="portrait">
      <Image src={portrait} alt="Grace Joy Park" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
    </div>
    <div class="intro">
      <h1>Grace Joy Park</h1>
      <p class="muted">Journalism &amp; advertising student at the University of Georgia.</p>
      <p>
        I write, photograph, and tell stories. This is a small home for my
        work: clips from my time at UGA, projects in progress, and what's
        coming next.
      </p>
      <p>
        <a href="/about">More about me &rarr;</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    margin-top: 1rem;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .intro p { max-width: 38ch; }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait { max-width: 320px; }
  }
</style>
