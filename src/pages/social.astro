---
import Base from "../layouts/Base.astro";

const instagramPosts = [
  "https://www.instagram.com/p/DXKTjK-RaCf/",
  "https://www.instagram.com/p/DXcYo5viZgU/",
  "https://www.instagram.com/p/DXuZu4wkfwi/",
];
---

<Base title="Social Media | Grace Joy Park">
  <h1>Social Media</h1>
  <p class="muted lead">A few favorite posts from Instagram.</p>

  <div class="grid">
    {instagramPosts.map((url) => (
      <blockquote
        class="instagram-media"
        data-instgrm-permalink={url}
        data-instgrm-version="14"
      ></blockquote>
    ))}
  </div>

  <script async src="https://www.instagram.com/embed.js"></script>
</Base>

<style>
  .lead { margin-bottom: 2.5rem; }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    align-items: flex-start;
  }

  /* Each embed sized to Instagram's natural reel width and centered in the row. */
  .grid :global(.instagram-media) {
    min-width: 0 !important;
    width: 540px !important;
    max-width: 100% !important;
    margin: 0 !important;
    flex: 0 0 540px;
  }

  /* Force enough vertical room for vertical reels so black bars don't appear. */
  .grid :global(iframe.instagram-media) {
    min-height: 820px !important;
  }
  .grid :global(.instagram-media iframe) {
    min-height: 820px !important;
  }

  @media (max-width: 600px) {
    .grid :global(.instagram-media) {
      width: 100% !important;
      flex-basis: 100%;
    }
    .grid :global(iframe.instagram-media),
    .grid :global(.instagram-media iframe) {
      min-height: 720px !important;
    }
  }
</style>
