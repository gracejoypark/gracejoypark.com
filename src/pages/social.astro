---
import Base from "../layouts/Base.astro";

const instagramPosts = [
  "https://www.instagram.com/p/DXKTjK-RaCf/",
  "https://www.instagram.com/p/DXuZu4wkfwi/",
];
---

<Base title="Social Media | Grace Joy Park">
  <h1>Social Media</h1>

  <div class="grid">
    {instagramPosts.map((url) => (
      <blockquote
        class="instagram-media"
        data-instgrm-permalink={url}
        data-instgrm-version="14"
      ></blockquote>
    ))}
  </div>

  <script async src="https://www.instagram.com/embed.js"></script>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 420px));
    gap: 1.5rem;
    align-items: start;
  }

  .grid :global(.instagram-media) {
    min-width: 0 !important;
    width: 100% !important;
    margin: 0 !important;
  }
</style>
