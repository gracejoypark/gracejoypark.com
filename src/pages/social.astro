---
import Base from "../layouts/Base.astro";

// Each entry is the post shortcode at the end of an instagram.com/p/{id}/ or /reel/{id}/ URL.
const reelIds = [
  "DXKTjK-RaCf",
  "DXcYo5viZgU",
  "DXuZu4wkfwi",
];
---

<Base title="Social Media | Grace Joy Park">
  <h1>Social Media</h1>
  <p class="muted lead">A few favorite posts from Instagram.</p>

  <div class="grid">
    {reelIds.map((id) => (
      <div class="reel">
        <iframe
          src={`https://www.instagram.com/reel/${id}/embed/`}
          title="Instagram reel"
          loading="lazy"
          scrolling="no"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          allowtransparency="true"
          allowfullscreen
        ></iframe>
      </div>
    ))}
  </div>
</Base>

<style>
  .lead { margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    align-items: start;
    justify-content: center;
  }

  /*
   * Instagram's reel embed page renders a 9:16 video plus a username header
   * and a likes/comments footer. We give the wrapper a tall aspect ratio
   * (roughly 5:11) so a 9:16 reel can fill the iframe width and the chrome
   * still has room above and below it.
   */
  .reel {
    width: 100%;
    aspect-ratio: 5 / 11;
    background: #fff;
    border: 1px solid var(--rule);
    overflow: hidden;
  }

  .reel iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
