---
import Base from "../layouts/Base.astro";

// type: "reel" uses /reel/{id}/embed/ and a 9:16 frame with chrome cropped.
// type: "post" uses /p/{id}/embed/ and a taller frame to fit the photo plus chrome.
const posts = [
  { id: "DXKTjK-RaCf", type: "reel" as const },
  { id: "DXcYo5viZgU", type: "reel" as const },
  { id: "DXuZu4wkfwi", type: "post" as const },
];
---

<Base title="Social Media | Grace Joy Park">
  <h1>Social Media</h1>
  <p class="muted lead">A few favorite posts from Instagram.</p>

  <div class="grid">
    {posts.map(({ id, type }) => (
      <div class={`embed ${type === "reel" ? "is-reel" : "is-post"}`}>
        <iframe
          src={`https://www.instagram.com/${type === "reel" ? "reel" : "p"}/${id}/embed/`}
          title={type === "reel" ? "Instagram reel" : "Instagram post"}
          loading="lazy"
          scrolling="no"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          allowtransparency="true"
          allowfullscreen
        ></iframe>
      </div>
    ))}
  </div>
</Base>

<style>
  .lead { margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    align-items: start;
    justify-content: center;
  }

  .embed {
    width: 100%;
    background: #000;
    border: 1px solid var(--rule);
    overflow: hidden;
    position: relative;
  }

  /*
   * Reels: lock the box to the 9:16 video shape so the reel touches top and
   * bottom of the frame. Push Instagram's header up and the footer down past
   * the visible area by oversizing the iframe and offsetting it.
   */
  .embed.is-reel {
    aspect-ratio: 9 / 16;
  }

  .embed.is-reel iframe {
    position: absolute;
    top: -60px;
    left: 0;
    width: 100% !important;
    height: calc(100% + 220px) !important;
    border: 0;
    display: block;
  }

  /*
   * Carousels / photo posts: image is roughly 1:1, but the embed adds header
   * and footer chrome. Give it enough vertical room to show photo + chrome.
   */
  .embed.is-post {
    aspect-ratio: 4 / 5;
    background: #fff;
  }

  .embed.is-post iframe {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    border: 0;
    display: block;
  }
</style>
