---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import businessBeat from "../assets/gallery/business-beat.jpg";
import interview from "../assets/gallery/interview.jpg";
import grady from "../assets/gallery/grady.jpg";
import friends from "../assets/gallery/friends.jpg";

// Drop new photos in `src/assets/gallery/`, import them above, and list them here.
// Astro auto-compresses, converts to WebP, and serves responsive sizes at build time.
const gallery = [
  { src: businessBeat, caption: "Presenting my Business Beat story on SCLPT Studio" },
  { src: interview, caption: "Interviewing for beat Q&A story" },
  { src: grady, caption: "Grady College, UGA" },
  { src: friends, caption: "With group members for Dog with the Dean coverage" },
];
---

<Base title="About — Grace Joy Park">
  <h1>About</h1>
  <div class="grid">
    <div class="image">
      <Image src={portrait} alt="Grace Joy Park" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
    </div>
    <div class="prose">
      <p>
        Hi, I'm Grace. I'm a student at the University of Georgia studying
        journalism, and switching to advertising next semester.
      </p>
      <p>
        I'm interested in the way stories get told — in print, on screens, and
        through brands — and how good writing and design can make either feel
        unforgettable.
      </p>
      <p>
        Outside of class I'm usually reading, taking photos, or working on
        small projects like this site.
      </p>
      <p>
        The best way to reach me is by <a href="/contact">email</a>.
      </p>
    </div>
  </div>

  <section class="gallery-section">
    <h2>Gallery</h2>
    <div class="gallery" role="list">
      {gallery.map((g) => (
        <figure class="item" role="listitem">
          <Image src={g.src} alt={g.caption} height={680} loading="lazy" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: start;
  }

  .image {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .prose p { max-width: 60ch; }

  .gallery-section {
    margin-top: 4rem;
  }

  .gallery-section h2 {
    margin-bottom: 1.25rem;
  }

  .gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .item {
    flex: 0 0 auto;
    margin: 0;
    scroll-snap-align: start;
  }

  .item img {
    height: 340px;
    width: auto;
    display: block;
    background: #f3efe6;
    border: 1px solid var(--rule);
  }


  .item figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Subtle scrollbar styling */
  .gallery::-webkit-scrollbar { height: 8px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb {
    background: var(--rule);
    border-radius: 4px;
  }
  .gallery::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 2rem; }
    .image { max-width: 320px; }
    .item img { height: 260px; }
  }
</style>
