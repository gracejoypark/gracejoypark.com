---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import businessBeat from "../assets/gallery/business-beat.jpg";
import interview from "../assets/gallery/interview.jpg";
import grady from "../assets/gallery/grady.jpg";
import friends from "../assets/gallery/friends.jpg";
import commissionMeeting from "../assets/gallery/commission-meeting.jpg";
import twilightBanner from "../assets/gallery/twilight-banner.jpg";

// Drop new photos in `src/assets/gallery/`, import them above, and list them here.
// Astro auto-compresses, converts to WebP, and serves responsive sizes at build time.
const gallery = [
  { src: businessBeat, caption: "Presenting my Business Beat story on SCLPT Studio" },
  { src: interview, caption: "Interviewing for beat Q&A story" },
  { src: grady, caption: "Grady College, UGA" },
  { src: friends, caption: "With group members for Dog with the Dean coverage" },
  { src: commissionMeeting, caption: "Covering the Athens-Clarke County data center moratorium vote" },
  { src: twilightBanner, caption: "Reporting at the 46th Athens Orthopedic Clinic Twilight Criterium" },
];
---

<Base title="About | Grace Joy Park">
  <div class="grid">
    <div class="image">
      <Image src={portrait} alt="Grace Joy Park" widths={[400, 600, 900]} sizes="(max-width: 720px) 90vw, 40vw" />
    </div>
    <div class="prose">
      <h1>About</h1>
      <p>
        I'm a journalism major at the University of Georgia's Grady College,
        switching to advertising next semester. Both fields ask the same first
        question: what is this story actually about, and how do you say it so
        people read to the end?
      </p>
      <p>
        Through Reporting I this semester, I covered an Athens-Clarke County
        commission vote on the data center moratorium, ran a Q&amp;A with
        Oconee State Bank&rsquo;s Cayce Reese on community banking and
        reported on SCLPT Studio, a boutique fitness studio at maximum
        capacity in its first year. At a January ICE protest at the Tate
        Student Center, I worked in photo and cutline form, where the
        caption carries the reporting.
      </p>
      <p>
        In fall 2025, I served as Section Editor for Fashion and Beauty at
        <a href="/work/infusion">Infusion Magazine</a>, where I led content
        strategy, edited two drafts of every piece and argued for cohesion
        with the editorial board. Coursework in Law of Mass Communication
        and Media News and Consumers shaped how I think about ethics,
        sourcing and audience.
      </p>
      <p>
        Reading The Associated Press on my phone has trained me to strip
        opinion from a story and lead with verified facts. The New York
        Times has shaped my sense of transparency through its public
        corrections and the bylines that explain how reporters cover beats.
      </p>
      <p>
        After the advertising switch, I want to keep reporting like this
        and carry those habits into copy work.
      </p>
    </div>
  </div>

  <section class="gallery-section">
    <h2>Gallery</h2>
    <div class="gallery" role="list">
      {gallery.map((g) => (
        <figure class="item" role="listitem">
          <Image src={g.src} alt={g.caption} height={680} loading="lazy" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: start;
  }

  .image {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
    overflow: hidden;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .prose p { max-width: 60ch; }

  .gallery-section {
    margin-top: 4rem;
  }

  .gallery-section h2 {
    margin-bottom: 1.25rem;
  }

  .gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .item {
    flex: 0 0 auto;
    margin: 0;
    scroll-snap-align: start;
  }

  .item img {
    height: 340px;
    width: auto;
    display: block;
    background: #f3efe6;
    border: 1px solid var(--rule);
  }


  .item figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Subtle scrollbar styling */
  .gallery::-webkit-scrollbar { height: 8px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb {
    background: var(--rule);
    border-radius: 4px;
  }
  .gallery::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 2rem; }
    .image { max-width: 320px; }
    .item img { height: 260px; }
  }
</style>
