---
import Base from "../layouts/Base.astro";

// Drop your photos in `public/gallery/` and list their paths here.
// Add a caption to each — it shows under the image and is used as alt text.
const gallery = [
  { src: "/gallery/photo-1.jpg", caption: "Caption goes here" },
  { src: "/gallery/photo-2.jpg", caption: "Caption goes here" },
  { src: "/gallery/photo-3.jpg", caption: "Caption goes here" },
  { src: "/gallery/photo-4.jpg", caption: "Caption goes here" },
  { src: "/gallery/photo-5.jpg", caption: "Caption goes here" },
];
---

<Base title="About — Grace Joy Park">
  <h1>About</h1>
  <div class="grid">
    <div class="image">
      <div class="placeholder">
        <span>Your photo here</span>
      </div>
    </div>
    <div class="prose">
      <p>
        Hi, I'm Grace. I'm a student at the University of Georgia studying
        journalism, and switching to advertising next semester.
      </p>
      <p>
        I'm interested in the way stories get told — in print, on screens, and
        through brands — and how good writing and design can make either feel
        unforgettable.
      </p>
      <p>
        Outside of class I'm usually reading, taking photos, or working on
        small projects like this site.
      </p>
      <p>
        The best way to reach me is by <a href="/contact">email</a>.
      </p>
    </div>
  </div>

  <section class="gallery-section">
    <h2>Gallery</h2>
    <div class="gallery" role="list">
      {gallery.map((g) => (
        <figure class="item" role="listitem">
          <img src={g.src} alt={g.caption} loading="lazy" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: start;
  }

  .image {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-style: italic;
  }

  .prose p { max-width: 60ch; }

  .gallery-section {
    margin-top: 4rem;
  }

  .gallery-section h2 {
    margin-bottom: 1.25rem;
  }

  .gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .item {
    flex: 0 0 auto;
    width: 280px;
    margin: 0;
    scroll-snap-align: start;
  }

  .item img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    background: #f3efe6;
    border: 1px solid var(--rule);
  }

  .item figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Subtle scrollbar styling */
  .gallery::-webkit-scrollbar { height: 8px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb {
    background: var(--rule);
    border-radius: 4px;
  }
  .gallery::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 2rem; }
    .image { max-width: 320px; }
    .item { width: 220px; }
    .item img { height: 280px; }
  }
</style>
