---
import Base from "../layouts/Base.astro";
---

<Base title="About — Grace Joy Park">
  <h1>About</h1>
  <div class="grid">
    <div class="image">
      <div class="placeholder">
        <span>Your photo here</span>
      </div>
    </div>
    <div class="prose">
      <p>
        Hi, I'm Grace. I'm a student at the University of Georgia studying
        journalism, and switching to advertising next semester.
      </p>
      <p>
        I'm interested in the way stories get told — in print, on screens, and
        through brands — and how good writing and design can make either feel
        unforgettable.
      </p>
      <p>
        Outside of class I'm usually reading, taking photos, or working on
        small projects like this site.
      </p>
      <p>
        The best way to reach me is by <a href="/contact">email</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: start;
  }

  .image {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: #f3efe6;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-style: italic;
  }

  .prose p { max-width: 60ch; }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 2rem; }
    .image { max-width: 320px; }
  }
</style>
