---
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import springCover from "../../assets/work/infusion-covers/spring-2026.jpg";
import fallCover from "../../assets/work/infusion-covers/fall-2025.jpg";

const siteUrl = "https://infusionuga.wordpress.com/";

const issues = [
  {
    cover: springCover,
    label: "Vol. 23, Issue II",
    season: "Spring 2026",
    pdf: "https://infusionuga.wordpress.com/wp-content/uploads/2026/04/infusion-spring-2026.pdf",
  },
  {
    cover: fallCover,
    label: "Vol. 23, Issue I",
    season: "Fall 2025",
    pdf: "https://infusionuga.wordpress.com/wp-content/uploads/2025/11/infusion-fall-2025.pdf",
  },
];
---

<Base
  title="Infusion Magazine | Grace Joy Park"
  description="Grace Joy Park's Fashion and Beauty Editor work on Infusion Magazine, UGA's multicultural publication, across Vol. 23 Issue I (fall 2025) and Issue II (spring 2026)."
>
  <p class="back"><a href="/work">&larr; Back to Work</a></p>
  <h1>Infusion Magazine</h1>
  <p class="meta muted">Fashion and Beauty Editor &middot; Vol. 23, Issues I and II</p>

  <div class="prose">
    <p>
      I served as Fashion and Beauty Editor for Infusion Magazine, UGA's first
      and only multicultural publication. I led the Fashion and Beauty section
      for Volume 23, Issue I in fall 2025 and returned for Issue II in spring
      2026. I assigned and edited the section's pieces, took two major passes on
      every draft to keep the writing on AP Style and on brand and worked with
      the editorial board to fit the section into each issue's themes.
    </p>
    <p>
      Both issues are published in full on the
      <a href={siteUrl} target="_blank" rel="noopener noreferrer">official Infusion Magazine site</a>.
    </p>
  </div>

  <section class="issues">
    {issues.map((issue) => (
      <figure class="issue">
        <a href={issue.pdf} target="_blank" rel="noopener noreferrer">
          <Image
            src={issue.cover}
            alt={`Infusion Magazine ${issue.label} cover`}
            widths={[300, 500, 800]}
            sizes="(max-width: 720px) 80vw, 300px"
            format="webp"
          />
        </a>
        <figcaption>
          <a href={issue.pdf} target="_blank" rel="noopener noreferrer">
            {issue.label} &middot; {issue.season} &rarr;
          </a>
        </figcaption>
      </figure>
    ))}
  </section>

  <section class="why-section">
    <h2>What I Learned</h2>
    <p>
      Editing other students' work taught me things reporting alone could not.
      I had to assign pieces I would not have written myself, including a story
      on colorism in the South Asian community and a feature on defiant fashion,
      and figure out how to line-edit them without flattening the writer's voice.
      Sitting on the editorial board also meant arguing for the section in front
      of the rest of the staff, which is the part I was most nervous about and
      the part I learned the most from. Coming back for a second issue, I knew
      the section and could push it further.
    </p>
  </section>
</Base>

<style>
  .back { margin-bottom: 1rem; font-size: 0.95rem; }

  .meta {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2rem;
  }

  .prose p {
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .issues {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .issue {
    margin: 0;
    width: 100%;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .issue :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    display: block;
  }

  .issue figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    text-align: center;
  }

  .why-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .why-section h2 {
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .why-section p {
    margin: 0;
    line-height: 1.6;
  }
</style>
